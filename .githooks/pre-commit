#!/bin/sh
# Blocks a commit that adds a secret. Enable once per clone:
#   git config core.hooksPath .githooks
# Needs gitleaks on PATH: https://github.com/gitleaks/gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH; install it or the commit is not scanned" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
