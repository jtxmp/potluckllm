{
  "name": "potluckllm",
  "version": "0.1.1",
  "description": "Share access to local LLMs privately, peer-to-peer.",
  "license": "MIT",
  "author": "JT (https://github.com/jtxmp)",
  "homepage": "https://github.com/jtxmp/potluckllm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtxmp/potluckllm.git"
  },
  "bugs": {
    "url": "https://github.com/jtxmp/potluckllm/issues"
  },
  "keywords": [
    "p2p",
    "peer-to-peer",
    "hyperswarm",
    "holepunch",
    "ollama",
